{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "p2pmetronome-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-27",
  "routes": [
    {
      "pattern": "metronome-signal.tico-tico.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Comma-separated frontend origins allowed to open signaling WebSockets.
    // localhost and private LAN origins (bun run dev) are always accepted.
    "ALLOWED_ORIGINS": "https://metronome.tico-tico.com",
    // Participants per room, not counting the host.
    "MAX_PARTICIPANTS": 50
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
