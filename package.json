{
  "name": "p2pmetronome",
  "type": "module",
  "private": true,
  "workspaces": ["frontend", "server"],
  "scripts": {
    "dev": "bun run --workspaces --parallel dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:server": "bun run --cwd server dev",
    "build:frontend": "bun run --cwd frontend build",
    "deploy:server": "bun run --cwd server deploy",
    "typecheck": "bun run --workspaces --sequential typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
